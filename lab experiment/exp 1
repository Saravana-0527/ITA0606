        "\n",
        "# Implementation of Expectation-Maximization Algorithm\n",
        "\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from sklearn.mixture import GaussianMixture\n",
        "\n",
        "# Generate sample dataset\n",
        "np.random.seed(42)\n",
        "\n",
        "X1 = np.random.normal(5, 1, (100, 2))\n",
        "X2 = np.random.normal(10, 1, (100, 2))\n",
        "\n",
        "X = np.vstack((X1, X2))\n",
        "\n",
        "# Create Gaussian Mixture Model\n",
        "gmm = GaussianMixture(\n",
        "    n_components=2,\n",
        "    random_state=42\n",
        ")\n",
        "\n",
        "# Train the model using EM algorithm\n",
        "gmm.fit(X)\n",
        "\n",
        "# Predict cluster labels\n",
        "labels = gmm.predict(X)\n",
        "\n",
        "# Display results\n",
        "print(\"Expectation-Maximization Algorithm\")\n",
        "print(\"----------------------------------\")\n",
        "\n",
        "print(\"\\nCluster Labels:\")\n",
        "print(labels)\n",
        "\n",
        "print(\"\\nMean of Gaussian Components:\")\n",
        "print(gmm.means_)\n",
        "\n",
        "print(\"\\nCovariance of Gaussian Components:\")\n",
        "print(gmm.covariances_)\n",
        "\n",
        "print(\"\\nMixing Weights:\")\n",
        "print(gmm.weights_)\n",
        "\n",
        "print(\"\\nNumber of Iterations:\", gmm.n_iter_)\n",
        "\n",
        "# Plot the clusters\n",
        "plt.scatter(\n",
        "    X[:, 0], X[:, 1],\n",
        "    c=labels, cmap='viridis'\n",
        ")\n",
        "\n",
        "plt.title(\"Expectation-Maximization Clustering\")\n",
        "plt.xlabel(\"Feature 1\")\n",
        "plt.ylabel(\"Feature 2\")\n",
        "plt.show()\n"
      ]
    }
